  - {fileID: 8926484042661618301}
  m_OperatorName: ShouldKillParticle
  m_HLSLCode: "bool ShouldKillProjectile(\r\n    in uint projectileId,\r\n    in
    StructuredBuffer<uint> destroyRequestsBuffer,\r\n    in uint destroyRequestsCount)\r\n{\r\n   
    for (uint i = 0; i < destroyRequestsCount; i++)\r\n    {\r\n        if (destroyRequestsBuffer[i]
    == projectileId)\r\n            return true;\r\n    }\r\n\r\n    return false;\r\n}"
  m_ShaderFile: {fileID: 0}
  m_AvailableFunctions:
    selection: ShouldKillProjectile
    selectedIndex: 0
